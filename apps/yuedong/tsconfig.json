{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@": ["src"],
      "@/*": ["src/*"],
      "@appCenter": ["src/views/appCenter/src"],
      "@appCenter/*": ["src/views/appCenter/src/*"],
      "@optCenter": ["src/views/optCenter/aiPatrolManage/src"],
      "@optCenter/*": ["src/views/optCenter/aiPatrolManage/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "**/*.js"]
}